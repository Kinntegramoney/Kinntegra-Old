        var portfolioList = readResult.recordset;

        rationalForTrade = portfolioList[0].RationalForTrade;
        id = cryptoEngine.ParamEncrypt(portfolioList[0].Id, true);

        if (isNRI == true) {
            if (transactionPortfolioTypeCode == 'W') {
                var portfolioEquity = portfolioList.filter(x => x.NRIPercentage > 0 && x.AllocationType == 'Equity');
                portfolioEquity.sort((a, b) => a.NRIPercentage - b.NRIPercentage).reverse();
                var portfolioDebt = portfolioList.filter(x => x.NRIPercentage > 0 && x.AllocationType == 'Debt');
                portfolioDebt.sort((a, b) => a.NRIPercentage - b.NRIPercentage).reverse();

                portfolio = portfolioEquity.concat(portfolioDebt);
            }
            else {
                portfolio = portfolioList.filter(x => x.IsNRI == true);
            }
        }
        else {
            if (transactionPortfolioTypeCode == 'W') {
                var portfolioEquity = portfolioList.filter(x => x.ResidentPercentage > 0 && x.AllocationType == 'Equity');
                portfolioEquity.sort((a, b) => a.ResidentPercentage - b.ResidentPercentage).reverse();
                var portfolioDebt = portfolioList.filter(x => x.ResidentPercentage > 0 && x.AllocationType == 'Debt');
                portfolioDebt.sort((a, b) => a.ResidentPercentage - b.ResidentPercentage).reverse();

                portfolio = portfolioEquity.concat(portfolioDebt);
            }
            else {
                portfolio = portfolioList.filter(x => x.IsResident == true);
            }
        }
    }

    return { Id: id, RationalForTrade: rationalForTrade, PortfolioSchemes: portfolio };
