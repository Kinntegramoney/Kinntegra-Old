async function getSIPPortfolioHolding(req, portfolioTypeId, clientAccountId) {
    var holdingAmount = 0;
    var portfolioSchemes = [];

    const readRequest = req.app.locals.db.request();
    readRequest.input("TransactionPortfolioTypeId", cryptoEngine.ParamDecrypt(portfolioTypeId, true))
        .input("ClientAccountId", cryptoEngine.ParamDecrypt(clientAccountId, true));
    const readResult = await readRequest.execute("GetActiveSIPAmount");
    if (readResult.recordset.length > 0) {
        portfolioSchemes = readResult.recordset;
    }

    if (portfolioSchemes.length > 0) {
        portfolioSchemes = portfolioSchemes.map(x => {
            const BSESchemeId = cryptoEngine.ParamEncrypt(x.BSESchemeId, true);
            const ClientAccountId = cryptoEngine.ParamEncrypt(x.ClientAccountId, true);

            return { ...x, BSESchemeId, ClientAccountId };
        });

        var holdingAmount = portfolioSchemes.reduce((sum, fund) => sum + fund.FundAmount, 0);
    }

    return { PortfolioTypeId: portfolioTypeId, HoldingAmount: holdingAmount, ClientAccountId: clientAccountId, PortfolioSchemes: portfolioSchemes };
}

