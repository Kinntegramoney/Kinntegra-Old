async function getTSTCLumpsumBuyAllocation(req, res, allocationData, amount) {
    var allocationSchemes = allocationData.PortfolioSchemes;
    var initialFundAmount = Math.round(amount / allocationSchemes.length);
    var remainingAmount = amount;

    for (let i = 0; i < allocationSchemes.length; i++) {
        var item = allocationSchemes[i];

        var bseScheme = item.FundOtherDetails;

        var minInvestmentAmount = 0;
        if (item.AvailableFolios.length > 0) {
            minInvestmentAmount = bseScheme.AdditionalPurchaseAmount;
        }
        else {
            minInvestmentAmount = bseScheme.MinimumPurchaseAmount;
        }

        if (remainingAmount >= minInvestmentAmount) {
            item.FundAmount = minInvestmentAmount;
            remainingAmount -= minInvestmentAmount;
        }
    }

    if (remainingAmount > 0) {
        for (let i = 0; i < allocationSchemes.length; i++) {
            var equityFundManagementsAmount = Math.round(remainingAmount / allocationSchemes.length);
            if (allocationSchemes[i].FundAmount != 0) {
                while (equityFundManagementsAmount >= allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier) {
                    equityFundManagementsAmount = equityFundManagementsAmount - allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier;
                    if (remainingAmount > allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier) {
                        allocationSchemes[i].FundAmount = allocationSchemes[i].FundAmount + allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier;
                        remainingAmount = remainingAmount - allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier;
                    }
                }

                var allocationPercentage = (allocationSchemes[i].FundAmount * 100) / amount;
                allocationSchemes[i].AllocationPercentage = parseFloat(allocationPercentage.toFixed(2));
                allocationSchemes[i].MarketAmount = allocationSchemes[i].FundAmount;
                allocationSchemes[i].MarketPercentage = allocationSchemes[i].AllocationPercentage;
            }
        }
    }

    if (remainingAmount > 0) {
        var equityFundManagementsAmount = Math.round(remainingAmount);
        for (let i = 0; i < allocationSchemes.length; i++) {
            if (allocationSchemes[i].FundAmount != 0) {
                while (equityFundManagementsAmount >= allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier) {
                    equityFundManagementsAmount = equityFundManagementsAmount - allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier;
                    if (remainingAmount >= allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier) {
                        allocationSchemes[i].FundAmount = allocationSchemes[i].FundAmount + allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier;
                        remainingAmount = remainingAmount - allocationSchemes[i].FundOtherDetails.PurchaseAmountMultiplier;
                    }
                }

                var allocationPercentage = (allocationSchemes[i].FundAmount * 100) / amount;
                allocationSchemes[i].AllocationPercentage = parseFloat(allocationPercentage.toFixed(2));
                allocationSchemes[i].MarketAmount = allocationSchemes[i].FundAmount;
                allocationSchemes[i].MarketPercentage = allocationSchemes[i].AllocationPercentage;
            }
        }
    }

    // console.log('remainingAmount: ' + remainingAmount);

    return allocationData;
};

