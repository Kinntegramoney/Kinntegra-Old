                        catch (err) {
                            console.log(err);
                            try {
                                await transaction.rollback();
                            } catch (sqlerr) {
                                console.log(sqlerr);
                            }
                        }
                    }

                    var totalSchemes = clientTransactionData.ClientTransactionPortfolios[i].Allocations.filter(x => x.UCC != '').length;
                    var isInvalidOrders = clientTransactionData.ClientTransactionPortfolios[i].Allocations.filter(x => x.BSEOrderStatus === 'INVALID' && x.UCC != '').length;
                    var failedOrders = clientTransactionData.ClientTransactionPortfolios[i].Allocations.filter(x => x.BSEOrderId === '0' && x.UCC != '').length;

                    if (failedOrders > 0) {
                        if ((isInvalidOrders > 0) && totalSchemes == failedOrders) {
                            tradeStatus = 'Rejected';
                        }
                        else {
                            tradeStatus = 'Partially Failed';
                        }
                    }
                    else {
                        tradeStatus = 'Processing';
                    }

                    try {
                        await transaction.begin();

                        const requestStatus = transaction.request();
