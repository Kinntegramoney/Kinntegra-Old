                    var totalSchemes = transactionDataPortfolioItem.Allocations.filter(x => x.SubTransactionType == 'SIP').length;
                    var isInvalidOrders = transactionDataPortfolioItem.Allocations.filter(x => x.BSEOrderStatus === 'INVALID' && x.SubTransactionType == 'SIP').length;
                    var failedOrders = transactionDataPortfolioItem.Allocations.filter(x => x.BSEOrderId === '0' && x.SubTransactionType == 'SIP').length;

                    var tradeStatus = 'Processing';
                    if (failedOrders > 0) {
                        if ((isInvalidOrders > 0) && totalSchemes == failedOrders) {
                            tradeStatus = 'Rejected';
