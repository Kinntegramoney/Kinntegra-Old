exports.SaveClientTransation = async (req, res) => {
    var { Id, TransactionDate, PANCardNumber, FirstHolderName, ClientAccounts, TransactionTypeId, TransactionPlanId, SellCriteria, TransactionPortfolioTypes, IntraSwitchSchemeTypes, IntraSwitchSchemes, STPSwitchSchemes, SwitchBy, STPType } = req.body;

    let TransactionPortfolioTypesData = JSON.parse(TransactionPortfolioTypes);
    let ClientAccountsData = JSON.parse(ClientAccounts);
    let IntraSwitchSchemeTypesData = JSON.parse(IntraSwitchSchemeTypes);
    let IntraSwitchSchemesData = JSON.parse(IntraSwitchSchemes);
    let STPSwitchSchemesData = JSON.parse(STPSwitchSchemes);

    var errorMessage = "Error while client transaction data...";

    const transaction = req.app.locals.db.transaction();
    try {
        var currentDate = luxon.DateTime.now().setZone('Asia/Kolkata');

        var existingTransactionPortfolioTypes = [];
        var currentTransactionPortfolioTypes = [];
        var deletedTransactionPortfolioTypes = [];

        const readRequest = req.app.locals.db.request();
        readRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true));
        const readResult = await readRequest.execute("GetClientTransactionPortfolioTypes");
        if (readResult.recordset.length > 0) {
            var dataList = readResult.recordset;
            for (let i = 0; i < dataList.length; i++) {
                existingTransactionPortfolioTypes.push(dataList[i].TransactionPortfolioTypeId);
            }
        }

        for (let i = 0; i < TransactionPortfolioTypesData.length; i++) {
            currentTransactionPortfolioTypes.push(cryptoEngine.ParamDecrypt(TransactionPortfolioTypesData[i].Id, true));
        }

        deletedTransactionPortfolioTypes = existingTransactionPortfolioTypes.filter(f => !currentTransactionPortfolioTypes.includes(f));

        var existingSTPSwitchSchemes = [];
        var currentSTPSwitchSchemes = [];
        var deletedSTPSwitchSchemes = [];

        const readSTPSwitchSchemeRequest = req.app.locals.db.request();
        readSTPSwitchSchemeRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true));
        const readSTPSwitchSchemeResult = await readSTPSwitchSchemeRequest.execute("GetClientTransactionSTPSwitchAllocation");
        if (readSTPSwitchSchemeResult.recordset.length > 0) {
            var dataList = readSTPSwitchSchemeResult.recordset;
            for (let i = 0; i < dataList.length; i++) {
                existingSTPSwitchSchemes.push({ ProductCode: dataList[i].ProductCodeSwitchFrom, FolioNumber: dataList[i].FolioNumber });
            }
        }

        for (let i = 0; i < STPSwitchSchemesData.length; i++) {
            currentSTPSwitchSchemes.push({ ProductCode: STPSwitchSchemesData[i].ProductCode, FolioNumber: STPSwitchSchemesData[i].FolioNumber });
        }

        deletedSTPSwitchSchemes = existingSTPSwitchSchemes.filter(f => !currentSTPSwitchSchemes.includes(f));

        await transaction.begin();

        if (cryptoEngine.ParamDecrypt(Id, true) == 0) {
            const request = transaction.request();
            request.output("Id", msSql.BigInt)
                .input("TransactionTypeId", cryptoEngine.ParamDecrypt(TransactionTypeId, true))
                .input("PANCardNumber", PANCardNumber)
                .input("TransactionPlanId", cryptoEngine.ParamDecrypt(TransactionPlanId, true))
                .input("SellCriteria", SellCriteria)
                .input("SwitchBy", SwitchBy)
                .input("TradeStatus", 'In-Complete')
                .input("STPType", STPType)
                .input("FirstHolderName", FirstHolderName);
            const result = await request.execute("InsertClientTransaction");
            Id = cryptoEngine.ParamEncrypt(result.output.Id, true);
        }
        else {
            const request = transaction.request();
            request.input("Id", cryptoEngine.ParamDecrypt(Id, true))
                .input("TransactionDate", TransactionDate)
                .input("TransactionTypeId", cryptoEngine.ParamDecrypt(TransactionTypeId, true))
                .input("PANCardNumber", PANCardNumber)
                .input("TransactionPlanId", cryptoEngine.ParamDecrypt(TransactionPlanId, true))
                .input("SellCriteria", SellCriteria)
                .input("SwitchBy", SwitchBy)
                .input("STPType", STPType)
                .input("FirstHolderName", FirstHolderName);
            const result = await request.execute("UpdateClientTransaction");
        }

        const requestDeleteAccount = transaction.request();
        requestDeleteAccount.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true));
        const resultDeleteAccount = await requestDeleteAccount.execute("DeleteClientTransactionAccount");

        const requestDeleteNonAccount = transaction.request();
        requestDeleteNonAccount.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true));
        const resultDeleteNonAccount = await requestDeleteNonAccount.execute("DeleteClientTransactionNonAccount");

        const requestDeleteSwitchSchemeType = transaction.request();
        requestDeleteSwitchSchemeType.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true));
        const resultDeleteSwitchSchemeType = await requestDeleteSwitchSchemeType.execute("DeleteClientTransactionSwitchSchemeType");

        var systemClientAccounts = ClientAccountsData.filter(x => x.UCC != '');
        for (let i = 0; i < systemClientAccounts.length; i++) {
            var account = systemClientAccounts[i];

            const request = transaction.request();
            request.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("ClientAccountId", cryptoEngine.ParamDecrypt(account.Id, true));
            const result = await request.execute("InsertClientTransactionAccount");
        }

        var nonClientAccounts = ClientAccountsData.filter(x => x.UCC == '');
        for (let i = 0; i < nonClientAccounts.length; i++) {
            var account = nonClientAccounts[i];

            const request = transaction.request();
            request.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("FirstHolderName", account.FirstHolderName)
                .input("SecondHolderName", account.SecondHolderName)
                .input("ThirdHolderName", account.ThirdHolderName)
                .input("FirstNomineeName", account.FirstNomineeName)
                .input("SecondNomineeName", account.SecondNomineeName)
                .input("ThirdNomineeName", account.ThirdNomineeName)
                .input("GuardianName", account.GuardianName);
            const result = await request.execute("InsertClientTransactionNonAccount");
        }

        for (let i = 0; i < deletedTransactionPortfolioTypes.length; i++) {
            const transactionPortfolioTypeDeleteRequest = transaction.request();
            transactionPortfolioTypeDeleteRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("TransactionPortfolioTypeId", deletedTransactionPortfolioTypes[i]);
            const TransactionPortfolioTypeDeleteResult = await transactionPortfolioTypeDeleteRequest.execute("DeleteClientTransactionPortfolioType");
        }

        for (let i = 0; i < TransactionPortfolioTypesData.length; i++) {
            const transactionPortfolioTypeDetailsRequest = transaction.request();
            transactionPortfolioTypeDetailsRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("TransactionPortfolioTypeId", cryptoEngine.ParamDecrypt(TransactionPortfolioTypesData[i].Id, true));

            const TransactionPortfolioTypeDetailsResult = await transactionPortfolioTypeDetailsRequest.execute("InsertClientTransactionPortfolioType");
        }

        for (let i = 0; i < IntraSwitchSchemeTypesData.length; i++) {
            const switchSchemeTypeRequest = transaction.request();
            switchSchemeTypeRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("SchemeType", IntraSwitchSchemeTypesData[i].Code);

            const switchSchemeTypeResult = await switchSchemeTypeRequest.execute("InsertClientTransactionSwitchSchemeType");
        }

        for (let i = 0; i < deletedSTPSwitchSchemes.length; i++) {
            const stpSwitchSchemesDeleteRequest = transaction.request();
            stpSwitchSchemesDeleteRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("ProductCodeSwitchFrom", deletedSTPSwitchSchemes[i].ProductCode)
                .input("FolioNumber", deletedSTPSwitchSchemes[i].FolioNumber);
            const stpSwitchSchemesDeleteResult = await stpSwitchSchemesDeleteRequest.execute("DeleteClientTransactionSTPSwitchAllocation");
        }

        for (let i = 0; i < STPSwitchSchemesData.length; i++) {
            const stpSwitchSchemesRequest = transaction.request();
            stpSwitchSchemesRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("ProductCodeSwitchFrom", STPSwitchSchemesData[i].ProductCode)
                .input("FolioNumber", STPSwitchSchemesData[i].FolioNumber)
                .input("AllocationType", '')
                .input("ProductCodeSwitchTo", '')
                .input("AvailableAmount", 0)
                .input("AvailableUnits", 0)
                .input("Amount", 0)
                .input("Units", 0)
                .input("CapitalGain", 0)
                .input("ExitFreeUnits", 0)
                .input("ExitFreeAmount", 0)
                .input("TradeStatus", 'Pending')
                .input("SchemeType", STPSwitchSchemesData[i].SchemeType);

            const stpSwitchSchemesResult = await stpSwitchSchemesRequest.execute("InsertClientTransactionSTPSwitchAllocation");
        }

        await transaction.commit();
    } catch (err) {
        console.log(err);
        try {
            await transaction.rollback();
        } catch (sqlerr) {
            console.log(sqlerr);
        }

        if (err.message.includes("UK_")) {
            errorMessage = "Duplicate record. Record already exists.";
        }

        res.status(500).send(errorMessage);
        return;
    }

    try {
        const requestTaxFree = req.app.locals.db.request();
        requestTaxFree.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
            .input("PortfolioTypeCode", 'A')
            .input("TradeDate", currentDate.toFormat('yyyy-MM-dd'))
            .input("CalculationType", 'TF');
        const resultTaxFree = await requestTaxFree.execute("GetClientTransactionTaxFreeCalculation");

        var sellTaxFreeData = await getSellTaxFeeData(req, res, Id);

        if (SwitchBy == 'TF') {
            IntraSwitchSchemesData = [];

            var taxFreeData = sellTaxFreeData.filter(x => x.TaxFreeAmount > 0);

            for (let i = 0; i < taxFreeData.length; i++) {
                var existingScheme = IntraSwitchSchemesData.find(x => x.ProductCode == taxFreeData[i].ProductCode && x.FolioNumber == taxFreeData[i].FolioNumber);
                if (existingScheme == null) {
                    var scheme = await getRecommendedScheme(req, taxFreeData[i].ProductCode);

                    IntraSwitchSchemesData.push({ ProductCode: taxFreeData[i].ProductCode, FolioNumber: taxFreeData[i].FolioNumber, SchemeType: ((scheme != null) ? 'R' : 'N') });
                }
            }
        }

        var existingIntraSwitchSchemes = [];
        var currentIntraSwitchSchemes = [];
        var deletedIntraSwitchSchemes = [];

        const readIntraSwitchSchemeRequest = req.app.locals.db.request();
        readIntraSwitchSchemeRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true));
        const readIntraSwitchSchemeResult = await readIntraSwitchSchemeRequest.execute("GetClientTransactionIntraSwitchAllocation");
        if (readIntraSwitchSchemeResult.recordset.length > 0) {
            var dataList = readIntraSwitchSchemeResult.recordset;
            for (let i = 0; i < dataList.length; i++) {
                existingIntraSwitchSchemes.push({ ProductCode: dataList[i].ProductCodeSwitchFrom, FolioNumber: dataList[i].FolioNumber });
            }
        }

        for (let i = 0; i < IntraSwitchSchemesData.length; i++) {
            currentIntraSwitchSchemes.push({ ProductCode: IntraSwitchSchemesData[i].ProductCode, FolioNumber: IntraSwitchSchemesData[i].FolioNumber });
        }

        deletedIntraSwitchSchemes = existingIntraSwitchSchemes.filter(f => !currentIntraSwitchSchemes.includes(f));

        await transaction.begin();

        for (let i = 0; i < deletedIntraSwitchSchemes.length; i++) {
            const intraSwitchSchemesDeleteRequest = transaction.request();
            intraSwitchSchemesDeleteRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("ProductCodeSwitchFrom", deletedIntraSwitchSchemes[i].ProductCode)
                .input("FolioNumber", deletedIntraSwitchSchemes[i].FolioNumber);
            const intraSwitchSchemesDeleteResult = await intraSwitchSchemesDeleteRequest.execute("DeleteClientTransactionIntraSwitchAllocation");
        }

        for (let i = 0; i < IntraSwitchSchemesData.length; i++) {
            const intraSwitchSchemesRequest = transaction.request();
            intraSwitchSchemesRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(Id, true))
                .input("ProductCodeSwitchFrom", IntraSwitchSchemesData[i].ProductCode)
                .input("FolioNumber", IntraSwitchSchemesData[i].FolioNumber)
                .input("AllocationType", '')
                .input("ProductCodeSwitchTo", '')
                .input("AvailableAmount", 0)
                .input("AvailableUnits", 0)
                .input("Amount", 0)
                .input("Units", 0)
                .input("CapitalGain", 0)
                .input("ExitFreeUnits", 0)
                .input("ExitFreeAmount", 0)
                .input("ExitLoadUnits", 0)
                .input("ExitLoadCurrentAmount", 0)
                .input("TaxFreeUnits", 0)
                .input("TaxFreeAmount", 0)
                .input("TradeStatus", 'Pending')
                .input("SchemeType", IntraSwitchSchemesData[i].SchemeType);

            const intraSwitchSchemesResult = await intraSwitchSchemesRequest.execute("InsertClientTransactionIntraSwitchAllocation");
        }

        await transaction.commit();

        res.status(200).send({ Status: true, Message: "", Data: { Id: Id } });
    }
    catch (err) {
        console.log(err);
        try {
            await transaction.rollback();
        } catch (sqlerr) {
            console.log(sqlerr);
        }

        if (err.message.includes("UK_")) {
            errorMessage = "Duplicate record. Record already exists.";
        }

        res.status(500).send(errorMessage);
    }
};

