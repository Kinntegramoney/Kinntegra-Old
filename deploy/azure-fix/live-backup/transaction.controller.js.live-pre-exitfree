                            ASWPMinimumInstallmentAmount: 0,
                            ASWPMaximumInstallmentAmount: 0,
                            ASWPMultiplierAmount: 0,
                            ASWPMinimumInstallmentUnits: 0,
                            ASWPMaximumInstallmentUNits: 0,
                            ASWPMultiplierUnits: 0,
                            ASWPMinimumInstallmentNumber: 0,
                            ASWPMaximumInstallmentNumber: 0,
                            ASWPFrequency: '',
                            ASWPDates: '',
                            ASWPMinimumGap: 0,
                            ASWPMaximumGap: 0,
                            ASWPInstallmentGap: 0,
                            ASWPStatus: '',
                            Created: new Date(),
                            Modified: new Date()
                        };
                        fund.SWPType = 'Flexi SWP';
                    }

                    if (fund.UCC == '') {
                        fund.SWPType = 'Flexi SWP';
                    }

                    var clientSWPStartDate = luxon.DateTime.fromISO(swpPortfolio.SWPStartDate.toISOString(), { zone: 'Asia/Kolkata' });
                    if (clientSWPStartDate.day == 29 || clientSWPStartDate.day == 30 || clientSWPStartDate.day == 31) {
                        clientSWPStartDate = luxon.DateTime.fromObject({ year: clientSWPStartDate.year, month: clientSWPStartDate.month, day: 28 });
                    }

                    if (previousSWPDate == null) {
                        var swpStartDate = clientSWPStartDate;//luxon.DateTime.fromISO(swpPortfolio.SWPStartDate.toISOString(), { zone: 'Asia/Kolkata' });

                        if (schemeDetails != null && fund.SWPType == 'SWP') {
                            var swpDays = schemeDetails.ASWPDates.split(',').sort((a, b) => a - b).reverse();

                            var swpDay = swpDays.find(x => x <= clientSWPStartDate.day);
                            if (swpDay == null) {
                                swpDay = swpDays.find(x => x >= clientSWPStartDate.day);
                            }

                            swpStartDate = luxon.DateTime.fromObject({ year: swpStartDate.year, month: swpStartDate.month, day: swpDay });
                        }

                        fund.SWPStartDate = swpStartDate.toFormat('yyyy-MM-dd');
                        fund.SWPEndDate = swpStartDate.plus({ months: fund.SWPMonths - 1 }).toFormat('yyyy-MM-dd');
                    }
                    else {
                        var swpStartDate = luxon.DateTime.fromFormat(previousSWPDate, 'yyyy-MM-dd', { zone: 'Asia/Kolkata' }).plus({ months: 1 });

                        if (schemeDetails != null && fund.SWPType == 'SWP') {
                            var swpDays = schemeDetails.ASWPDates.split(',').sort((a, b) => a - b).reverse();

                            var swpDay = swpDays.find(x => x <= clientSWPStartDate.day);
                            if (swpDay == null) {
                                swpDay = swpDays.find(x => x >= clientSWPStartDate.day);
                            }

                            swpStartDate = luxon.DateTime.fromObject({ year: swpStartDate.year, month: swpStartDate.month, day: swpDay });
                        }
                        else {
                            swpStartDate = luxon.DateTime.fromObject({ year: swpStartDate.year, month: swpStartDate.month, day: clientSWPStartDate.day });
                        }

                        fund.SWPStartDate = swpStartDate.toFormat('yyyy-MM-dd');
                        fund.SWPEndDate = swpStartDate.plus({ months: fund.SWPMonths - 1 }).toFormat('yyyy-MM-dd');
                    }

                    previousSWPDate = fund.SWPEndDate;
                }
            }
        }

        // await prepareSellLogicData(req, res, ClientTransactionId, data, sellableData);

        res.status(200).send({ Status: true, Message: "", Data: swpAllocation });
    }
    catch (err) {
        console.log(err);
        res.status(500).send(errorMessage);
    }
};

exports.ResendClientTransactionLink = async (req, res) => {
    var { ClientTransactionId } = req.body;

    var errorMessage = "Error while client transaction data...";

    const transaction = req.app.locals.db.transaction();

    try {
        await transaction.begin();

        const requestStatus = transaction.request();
        requestStatus.input("Id", cryptoEngine.ParamDecrypt(ClientTransactionId, true))
            .input("TradeStatus", "Pending");
        const resultStatus = await requestStatus.execute("UpdateClientTransactionTradeStatus");

        await transaction.commit();
    } catch (err) {
        console.log(err);
        try {
            await transaction.rollback();
        } catch (sqlerr) {
            console.log(sqlerr);
        }

        if (err.message.includes("UK_")) {
            errorMessage = "Duplicate record. Record already exists.";
        }

        res.status(500).send(errorMessage);
        return;
    }

    try {
        var transactionData = await getClientTransactionInfo(req, res, ClientTransactionId);

        if (transactionData.TransactionTypeCode == 'B' && transactionData.TransactionPlanCode == 'L') {
            var firstHolder = transactionData.ClientAccount.AccountHolders.find(x => x.SerialNumber == 1);

            var timeStamp = new Date();
            var link = process.env.WEB_APP_LINK + '/confirm-order/' + transactionData.ClientAccount.ClientId + '/' + firstHolder.ClientKycProfileId + '/' + ClientTransactionId + '/' + cryptoEngine.ParamEncrypt(transactionData.TransactionTypeCode, true) + '/' + cryptoEngine.ParamEncrypt('externalverify', true) + '/' + cryptoEngine.ParamEncrypt(timeStamp.toISOString(), true) + '/' + cryptoEngine.ParamEncrypt('new', true);
            console.log(link);
            var subject = 'Kinntegra | New MF Purchase Order';
            emailEngine.SendClientOrderConfirmationLink(firstHolder.ProfileDetails.Email, firstHolder.ProfileDetails.Name, transactionData.ClientAccount.AssociateName, transactionData.ClientAccountList, link, subject);

        }
        else if (transactionData.TransactionTypeCode == 'B' && transactionData.TransactionPlanCode == 'SIP') {
            var modifySIPTrades = transactionData.ClientTransactionPortfolios.filter(x => x.SIPTransactionType == 'M');

            var firstHolder = transactionData.ClientAccount.AccountHolders.find(x => x.SerialNumber == 1);

            var timeStamp = new Date();
            var link = process.env.WEB_APP_LINK + '/confirm-order/' + transactionData.ClientAccount.ClientId + '/' + firstHolder.ClientKycProfileId + '/' + ClientTransactionId + '/' + cryptoEngine.ParamEncrypt(transactionData.TransactionTypeCode, true) + '/' + cryptoEngine.ParamEncrypt('externalverify', true) + '/' + cryptoEngine.ParamEncrypt(timeStamp.toISOString(), true) + '/' + cryptoEngine.ParamEncrypt('new', true);
            console.log(link);
            var subject = (modifySIPTrades.length > 0) ? 'Kinntegra | Existing SIP ModificationOrder' : 'Kinntegra | New MF Purchase Order';
            emailEngine.SendClientOrderConfirmationLink(firstHolder.ProfileDetails.Email, firstHolder.ProfileDetails.Name, transactionData.ClientAccount.AssociateName, transactionData.ClientAccountList, link, subject);
        }
        else if (transactionData.TransactionTypeCode == 'S') {
            var clientAccounts = transactionData.ClientAccounts;

