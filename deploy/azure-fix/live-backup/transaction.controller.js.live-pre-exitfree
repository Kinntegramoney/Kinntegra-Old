                //save transaction and scheduler link
                const transaction = req.app.locals.db.transaction();
                try {
                    await transaction.begin();

                    const transactionRequest = transaction.request();
                    transactionRequest.input("ClientTransactionBuyScheduleId", cryptoEngine.ParamDecrypt(schedulerItem.Id, true))
                        .input("ClientTransactionId", cryptoEngine.ParamDecrypt(clientTransactionId, true));
                    const TransactionResult = await transactionRequest.execute("InsertClientTransactionBuyScheduleTransaction");

                    const transactionStatusRequest = transaction.request();
                    transactionStatusRequest.input("Id", cryptoEngine.ParamDecrypt(schedulerItem.Id, true))
