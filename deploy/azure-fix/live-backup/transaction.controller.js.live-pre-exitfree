                    if (readAccountResult.recordset.length > 0) {
                        let dataList = readAccountResult.recordset;

                        clientAccounts = dataList.map(item => {
                            const Id = cryptoEngine.ParamEncrypt(item.Id, true);

                            return { ...item, Id };
                        });
                    }

                    for (let i = 0; i < clientAccounts.length; i++) {
                        var account = clientAccounts[i];

                        if (cryptoEngine.ParamDecrypt(account.Id, true) != 0) {
                            var holding = await getPortfolioTypeSellHolding(req, currentDate.toFormat('yyyy-MM-dd'), portfolioTypeItem.TransactionPortfolioTypeCode, account.Id);

                            portfolioTypeItem.CurrentAmount += holding.CurrentAmount;
                        }
                        else {
                            var holding = await getPortfolioTypeSellHoldingNonAccount(req, currentDate.toFormat('yyyy-MM-dd'), portfolioTypeItem.TransactionPortfolioTypeCode, account.FirstHolderName, account.SecondHolderName, account.ThirdHolderName, account.FirstNomineeName, account.SecondNomineeName, account.ThirdNomineeName, account.GuardianName);

                            portfolioTypeItem.CurrentAmount += holding.CurrentAmount;
                        }
                    }

                    allocation.forEach(async (x) => {
                        var currentHoldingData = await getFeedDailyHoldingAsOnDate(currentDate.toFormat('yyyy-MM-dd'), x.FolioNumber, x.ProductCode);
                        if (portfolioTypeItem.CustomSellType == 'P' && existingPortfolio != null) {
                            var existingItem = existingPortfolio.Allocations.find(a => a.FolioNumber == x.FolioNumber && a.BSESchemeId == x.BSESchemeId);
                            if (existingItem != null) {
                                x.SellUnits = existingItem.FundUnits;
                                x.SellAmount = existingItem.FundAmount;
                            }
                        }
                        x.AvailableUnits = (currentHoldingData != null) ? Number(currentHoldingData.Units.toFixed(3)) : 0;
                        x.CurrentAmount = Math.round(x.CurrentAmount);
                        x.SellUnits = Number(x.SellUnits.toFixed(3));
                        x.SellAmount = Math.round(x.SellAmount);
                    });

                    data.push({
                        Portfolio: portfolioTypeItem,
                        Allocation: allocation
                    });
                }
            }
        }

        res.status(200).send({ Status: true, Message: "", Data: data });
    }
    catch (err) {
        console.log(err);
        res.status(500).send(errorMessage);
    }
};

