            });
            step3XlsData.push(['', '', '', '', '', '', '', '', '', '', '', '', '', '']);

            var debtData = step3Data.Data.filter(x => x.SchemeType == 'Debt')
            step3XlsData.push(['Debt Scheme Name', 'Suggested Investment', 'Current Portfolio', 'Difference 1', 'Difference 2', 'Difference 3', 'Difference 4', 'Difference 5', 'Difference 6', 'Difference 7', 'Difference 8', 'Difference 9', 'Difference 10', 'Amount']);
            debtData.forEach(item => {
                step3XlsData.push([item.SchemeName, item.SuggestedInvestment, item.CurrentPortfolio, item.Difference1, item.Difference2, item.Difference3, item.Difference4, item.Difference5, item.Difference6, item.Difference7, item.Difference8, item.Difference9, item.Difference10, item.FinalAmount]);
            });
            step3XlsData.push(['', '', '', '', '', '', '', '', '', '', '', '', '', '']);

            var totalData = step3Data.Data.filter(x => x.SchemeType == 'Total')
            totalData.forEach(item => {
                step3XlsData.push([item.SchemeName, item.SuggestedInvestment, item.CurrentPortfolio, item.Difference1, item.Difference2, item.Difference3, item.Difference4, item.Difference5, item.Difference6, item.Difference7, item.Difference8, item.Difference9, item.Difference10, item.FinalAmount]);
