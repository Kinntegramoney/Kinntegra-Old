    var logicData = [];

    // var clientTransactionData = await getClientTransactionInfo(req, res, clientTransactionId);

    var baseAmount = Math.round((investmentAmount + portfolioMarketValue + provisionalBuy) - provisionalSell);

    //step 1
    var step1Data = [];
