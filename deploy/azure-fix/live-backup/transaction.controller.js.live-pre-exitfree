exports.GetSellPortfolioAllocation = async (req, res) => {
    const ClientTransactionId = req.params.ClientTransactionId;

    var errorMessage = "Error while fetching sell allocation...";

    try {
        var data = [];
        var sellableData = [];

        var currentDate = luxon.DateTime.now().setZone('Asia/Kolkata');

        var clientTransactionData = await getClientTransactionInfo(req, res, ClientTransactionId);

        // console.log(cryptoEngine.ParamDecrypt(ClientTransactionId, true));

        if (clientTransactionData.SellCriteria == 'A' || clientTransactionData.SellCriteria == 'P') {
            var portfolioTypeAllItem = clientTransactionData.PortfolioTypes.find(item => item.TransactionPortfolioTypeCode == 'A');
            var sellDataAll = [];

            portfolioTypeAllItem.CurrentAmount = 0;

            const readRequest = req.app.locals.db.request();
            readRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(ClientTransactionId, true))
                .input("PortfolioTypeCode", 'A')
                .input("TradeDate", currentDate.toFormat('yyyy-MM-dd'))
                .input("CalculationType", (portfolioTypeAllItem.CustomSellType == 'T') ? 'TF' : '');
            const readResult = await readRequest.execute("GetClientTransactionSellAllocation");
            if (readResult.recordset.length > 0) {
                // let dataList = readResult.recordset.filter(item => item.SellPriority > 0);
                let dataList = readResult.recordset;

                sellDataAll = dataList.map(item => {
                    const ClientTransactionPortfolioId = cryptoEngine.ParamEncrypt(item.ClientTransactionPortfolioId, true);

                    return { ...item, ClientTransactionPortfolioId };
                });
                // console.log(sellDataAll.length);
            }

            var allocationAll = [];

            if (portfolioTypeAllItem.SellFrom == 'R') {
                var portfolioData = clientTransactionData.ClientTransactionPortfolios.find(item => item.ClientTransactionPortfolioTypeId == portfolioTypeAllItem.ClientTransactionPortfolioTypeId);

                if (portfolioData != null) {
                    var portfolioSellAmount = portfolioData.Amount;

                    if (clientTransactionData.TransactionPlanCode == 'ASWP') {
                        portfolioSellAmount = portfolioData.SWPAmount;
                    }

                    for (let s = 0; s < sellDataAll.length; s++) {
                        var sellDataItem = sellDataAll[s];

                        var SellUnits = 0;
                        var SellAmount = 0;

                        if (sellDataItem.CurrentAmount <= portfolioSellAmount) {
                            if (portfolioSellAmount > 0) {
                                SellUnits = Number(sellDataItem.BalanceUnits.toFixed(3));
                                SellAmount = Math.round(sellDataItem.CurrentAmount);

                                portfolioSellAmount = portfolioSellAmount - Math.round(sellDataItem.CurrentAmount);

                                sellableData.push(sellDataItem);
                            }
                        }
                        else {
                            if (portfolioSellAmount > 0) {
                                SellUnits = Number(((sellDataItem.BalanceUnits * portfolioSellAmount) / Math.round(sellDataItem.CurrentAmount)).toFixed(3));
                                SellAmount = Math.round(portfolioSellAmount);

                                sellableData.push(sellDataItem);
                            }

                            portfolioSellAmount = 0;
                        }

                        var existingAllocation = allocationAll.find(item =>
                            item.FolioNumber == sellDataItem.FolioNumber &&
                            item.ProductCode == sellDataItem.ProductCode &&
                            item.UCC == sellDataItem.UCC &&
                            item.FirstHolderPan == sellDataItem.FirstHolderPan &&
                            item.SecondHolderPan == sellDataItem.SecondHolderPan &&
                            item.ThirdHolderPan == sellDataItem.ThirdHolderPan &&
                            item.GuardianPan == sellDataItem.GuardianPan &&
                            item.FirstNomineeName.toLowerCase() == sellDataItem.Nominee1Name.toLowerCase() &&
                            item.SecondNomineeName.toLowerCase() == sellDataItem.Nominee2Name.toLowerCase() &&
                            item.ThirdNomineeName.toLowerCase() == sellDataItem.Nominee3Name.toLowerCase());

                        if (existingAllocation == null) {
                            var schemeDetails = await getBseSchemeByIsin(sellDataItem.ISIN);

                            allocationAll.push({
                                ClientTransactionPortfolioId: sellDataItem.ClientTransactionPortfolioId,
                                BSESchemeId: schemeDetails.Id,
                                ISIN: sellDataItem.ISIN,
                                SchemeName: sellDataItem.SchemeName,
                                FolioNumber: sellDataItem.FolioNumber,
                                ProductCode: sellDataItem.ProductCode,
                                UCC: sellDataItem.UCC,
                                FirstHolderPan: sellDataItem.FirstHolderPan,
                                SecondHolderPan: sellDataItem.SecondHolderPan,
                                ThirdHolderPan: sellDataItem.ThirdHolderPan,
                                GuardianPan: sellDataItem.GuardianPan,
                                FirstHolderName: sellDataItem.FirstHolderName,
                                SecondHolderName: sellDataItem.SecondHolderName,
                                ThirdHolderName: sellDataItem.ThirdHolderName,
                                GuardianName: sellDataItem.GuardianName,
                                FirstNomineeName: sellDataItem.Nominee1Name,
                                SecondNomineeName: sellDataItem.Nominee2Name,
                                ThirdNomineeName: sellDataItem.Nominee3Name,
                                AvailableUnits: Number(sellDataItem.BalanceUnits.toFixed(3)),
                                CurrentAmount: Math.round(sellDataItem.CurrentAmount),
                                SellUnits: Number(SellUnits.toFixed(3)),
                                SellAmount: Math.round(SellAmount),
                                SchemeDetails: schemeDetails,
                                BankIFSC: sellDataItem.BankIFSC,
                                BankName: sellDataItem.BankName,
                                BankAccountType: sellDataItem.BankAccountType,
                                BankAccountNumber: sellDataItem.BankAccountNumber,
                                CurrentNAV: sellDataItem.CurrentNAV,
                                CurrentNAVDate: sellDataItem.CurrentNAVDate
                            });
                        }
                        else {
                            existingAllocation.AvailableUnits += Number(sellDataItem.BalanceUnits.toFixed(3));
                            existingAllocation.CurrentAmount += Math.round(sellDataItem.CurrentAmount);
                            existingAllocation.SellUnits += Number(SellUnits.toFixed(3));
                            existingAllocation.SellAmount += Math.round(SellAmount);
                        }
                    }
                }
            }
            else {
                if (portfolioTypeAllItem.CustomSellType == 'E') {
                    var portfolioData = clientTransactionData.ClientTransactionPortfolios.find(item => item.ClientTransactionPortfolioTypeId == portfolioTypeAllItem.ClientTransactionPortfolioTypeId);

                    if (portfolioData != null) {
                        var portfolioSellAmount = portfolioData.Amount;

                        var exitFreeData = sellDataAll.filter(x => x.ExitFreeUnits > 0)

                        for (let s = 0; s < exitFreeData.length; s++) {
                            var sellDataItem = exitFreeData[s];

                            var SellUnits = 0;
                            var SellAmount = 0;

