                    SecondHolderName: (secondHolder != null) ? secondHolder.ProfileDetails.Name : '',
                    ThirdHolderName: (thirdHolder != null) ? thirdHolder.ProfileDetails.Name : '',
                    FirstNomineeName: (firstNominee != null) ? firstNominee.NomineeName : '',
                    SecondNomineeName: (secondNominee != null) ? secondNominee.NomineeName : '',
                    ThirdNomineeName: (thirdNominee != null) ? thirdNominee.NomineeName : '',
                    GuardianName: (firstHolder != null) ? firstHolder.ProfileDetails.GuardianName : ''
                });
                // console.log('clientAccounts: ');
                // console.log(clientAccounts);
