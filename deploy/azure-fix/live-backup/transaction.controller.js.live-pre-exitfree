async function additionBuy(transactionBuyFunds, tempAllocations, baseAmount) {
    tempAllocations = tempAllocations.filter(x => x.IsHoliday == false && (x.SchemeType === 'Equity' || x.SchemeType === 'Debt'));

    var content = '';
    var equityNegativeSchemeAmount = 0;
    var debtNegativeSchemeAmount = 0;
    var totalPositiveSchemeAmount = 0;
    var totalNegativeSchemeAmount = 0;
    var totalPositiveScheme = 0;
    var totalNegativeScheme = 0;
    var equityPositiveScheme = 0;
    var debtPositiveScheme = 0;
    var equityNegativeScheme = 0;
    var debtNegativeScheme = 0;
    var equityAmountReduceFromPositive = 0;
    var debtAmountReduceFromPositive = 0;
    var differences = [];
    var diff = 'Difference';

    for (let a = 0; a < tempAllocations.length; a++) {
        var allocation = tempAllocations[a];

        allocation.Difference1 = allocation.SuggestedInvestment - allocation.CurrentPortfolio;

        if (allocation.SchemeType == 'Equity') {
            if (allocation.Difference1 < 0) {
                equityNegativeSchemeAmount = equityNegativeSchemeAmount + allocation.Difference1;
                totalNegativeScheme++;
                equityNegativeScheme++;
                //totalNegativeSchemeAmount = totalNegativeSchemeAmount + equityNegativeSchemeAmount;
            } else if (allocation.Difference1 > 0) {
                totalPositiveScheme++;
                equityPositiveScheme++;
                totalPositiveSchemeAmount = totalPositiveSchemeAmount + allocation.Difference1;
            }
        }

        if (allocation.SchemeType == 'Debt') {
            if (allocation.Difference1 < 0) {
                debtNegativeSchemeAmount = debtNegativeSchemeAmount + allocation.Difference1;
                totalNegativeScheme++;
                debtNegativeScheme++;
                //totalNegativeSchemeAmount = totalNegativeSchemeAmount + debtNegativeSchemeAmount;
            } else if (allocation.Difference1 > 0) {
                totalPositiveScheme++;
                debtPositiveScheme++;
                totalPositiveSchemeAmount = totalPositiveSchemeAmount + allocation.Difference1;
            }
        }
    }

    totalNegativeSchemeAmount = equityNegativeSchemeAmount + debtNegativeSchemeAmount;

    if (equityNegativeSchemeAmount != 0) {
        if (equityPositiveScheme > 0) {
            equityAmountReduceFromPositive = equityNegativeSchemeAmount / equityPositiveScheme;
        } else if (equityPositiveScheme == 0) {
            if (debtPositiveScheme > 0) {
                debtAmountReduceFromPositive = totalNegativeSchemeAmount / debtPositiveScheme;
            }
        }
    }

    if (debtNegativeSchemeAmount != 0) {
        if (debtPositiveScheme > 0) {
            debtAmountReduceFromPositive = debtNegativeSchemeAmount / debtPositiveScheme;
        } else if (debtPositiveScheme == 0) {
            if (equityPositiveScheme > 0) {
                equityAmountReduceFromPositive = totalNegativeSchemeAmount / equityPositiveScheme;
            }
        }
    }

    var difference1 = {
        EquityNegativeSchemeAmount: equityNegativeSchemeAmount,
        DebtNegativeSchemeAmount: debtNegativeSchemeAmount,
        TotalPositiveScheme: totalPositiveScheme,
        TotalNegativeScheme: totalNegativeScheme,
        EquityPositiveScheme: equityPositiveScheme,
        DebtPositiveScheme: debtPositiveScheme,
        EquityNegativeScheme: equityNegativeScheme,
        DebtNegativeScheme: debtNegativeScheme,
        EquityAmountReduceFromPositive: equityAmountReduceFromPositive,
        DebtAmountReduceFromPositive: debtAmountReduceFromPositive,
        TotalPositiveSchemeAmount: totalPositiveSchemeAmount,
        TotalNegativeSchemeAmount: totalNegativeSchemeAmount
    };

    differences["Difference1"] = difference1;

    for (let i = 2; i <= 10; i++) {
        let differenceKey = `Difference${i}`;
        let differenceLastKey = `Difference${i - 1}`;
        let differenceLast = differences[differenceLastKey] || 0; // Default to 0 if undefined

        var additionalDifferenceBuyResult = await additionalDifferenceBuy(i, differenceLast, tempAllocations, baseAmount);
        tempAllocations = additionalDifferenceBuyResult.TempAllocations
        differences[differenceKey] = additionalDifferenceBuyResult.Difference;
        // console.log(differences[differenceKey]);
    }

    return { TempAllocations: tempAllocations, Difference10: differences["Difference10"] };
}

async function additionalDifferenceBuy(i, diff, tempAllocations, baseAmount) {
    let j = i - 1;

    let differences = [];
    let equityNegativeSchemeAmount = 0;
    let debtNegativeSchemeAmount = 0;
    let totalPositiveSchemeAmount = 0;
    let totalNegativeSchemeAmount = 0;
    let totalPositiveScheme = 0;
    let totalNegativeScheme = 0;
    let equityPositiveScheme = 0;
    let debtPositiveScheme = 0;
    let equityNegativeScheme = 0;
    let debtNegativeScheme = 0;
    let equityAmountReduceFromPositive = 0;
    let debtAmountReduceFromPositive = 0;
    let equityPositiveSchemeAmount = 0;
    let debtPositiveSchemeAmount = 0;

    for (let a = 0; a < tempAllocations.length; a++) {
        var tallocation = tempAllocations[a];

        let currDiff = `Difference${i}`;
        let lastDiff = `Difference${j}`;

        if (tallocation.SchemeType === 'Equity') {
            if (tallocation[lastDiff] > 0 && diff.EquityAmountReduceFromPositive < 0) {
                let eqAmount = Math.round(tallocation[lastDiff] + diff.EquityAmountReduceFromPositive);
                tallocation[currDiff] = eqAmount;
            } else if (diff.EquityNegativeSchemeAmount === 0) {
                tallocation[currDiff] = tallocation[lastDiff];
            }

            if (tallocation[currDiff] < 0) {
                equityNegativeSchemeAmount += tallocation[currDiff];
                totalNegativeScheme++;
                equityNegativeScheme++;
            } else if (tallocation[currDiff] > 0) {
                totalPositiveScheme++;
                equityPositiveScheme++;
                equityPositiveSchemeAmount += tallocation[currDiff];
                totalPositiveSchemeAmount += tallocation[currDiff];
            }
        }

        if (tallocation.SchemeType === 'Debt') {
            if (tallocation[lastDiff] > 0 && diff.DebtAmountReduceFromPositive < 0) {
                let dbAmount = Math.round(tallocation[lastDiff] + diff.DebtAmountReduceFromPositive);
                tallocation[currDiff] = dbAmount;
            } else if (diff.DebtNegativeSchemeAmount === 0) {
                tallocation[currDiff] = tallocation[lastDiff];
            }

            if (tallocation[currDiff] < 0) {
                debtNegativeSchemeAmount += tallocation[currDiff];
                totalNegativeScheme++;
                debtNegativeScheme++;
            } else if (tallocation[currDiff] > 0) {
                totalPositiveScheme++;
                debtPositiveScheme++;
                debtPositiveSchemeAmount += tallocation[currDiff];
                totalPositiveSchemeAmount += tallocation[currDiff];
            }
        }

        if (i === 10) {
            tallocation.FinalAmount = tallocation[currDiff];
        }
    }

    totalNegativeSchemeAmount = equityNegativeSchemeAmount + debtNegativeSchemeAmount;

    if (equityNegativeSchemeAmount !== 0) {
        if (equityPositiveScheme > 0) {
            equityAmountReduceFromPositive = equityNegativeSchemeAmount / equityPositiveScheme;
        } else if (debtPositiveScheme > 0) {
            debtAmountReduceFromPositive = totalNegativeSchemeAmount / debtPositiveScheme;
        }
    }

    if (debtNegativeSchemeAmount !== 0) {
        if (debtPositiveScheme > 0) {
            debtAmountReduceFromPositive = debtNegativeSchemeAmount / debtPositiveScheme;
        } else if (equityPositiveScheme > 0) {
            equityAmountReduceFromPositive = totalNegativeSchemeAmount / equityPositiveScheme;
        }
    }

    // Store results in an object instead of using `$$currDiff`
    differences[`Difference${i}`] = {
        EquityNegativeSchemeAmount: equityNegativeSchemeAmount,
        DebtNegativeSchemeAmount: debtNegativeSchemeAmount,
        TotalPositiveScheme: totalPositiveScheme,
        TotalNegativeScheme: totalNegativeScheme,
        EquityPositiveScheme: equityPositiveScheme,
        DebtPositiveScheme: debtPositiveScheme,
        EquityNegativeScheme: equityNegativeScheme,
        DebtNegativeScheme: debtNegativeScheme,
        EquityAmountReduceFromPositive: equityAmountReduceFromPositive,
        DebtAmountReduceFromPositive: debtAmountReduceFromPositive,
        TotalPositiveSchemeAmount: totalPositiveSchemeAmount,
        TotalNegativeSchemeAmount: totalNegativeSchemeAmount,
        EquityPositiveSchemeAmount: equityPositiveSchemeAmount,
        DebtPositiveSchemeAmount: debtPositiveSchemeAmount
    };

    // console.log(tempAllocations);

    return { TempAllocations: tempAllocations, Difference: differences[`Difference${i}`] };
}

