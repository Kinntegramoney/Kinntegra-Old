                var timeStamp = new Date();
                var link = process.env.WEB_APP_LINK + '/confirm-order/' + transactionData.ClientAccount.ClientId + '/' + firstHolder.ClientKycProfileId + '/' + ClientTransactionId + '/' + cryptoEngine.ParamEncrypt(transactionData.TransactionTypeCode, true) + '/' + cryptoEngine.ParamEncrypt('externalverify', true) + '/' + cryptoEngine.ParamEncrypt(timeStamp.toISOString(), true) + '/' + cryptoEngine.ParamEncrypt('new', true);
                console.log(link);
                var subject = 'Kinntegra | New MF ' + ((transactionData.TransactionPlanCode == 'L') ? 'Sell' : 'SWP') + ' Order';
                emailEngine.SendClientOrderConfirmationLink(firstHolder.ProfileDetails.Email, firstHolder.ProfileDetails.Name, transactionData.ClientAccount.AssociateName, transactionData.ClientAccountList, link, subject);
            }
        }
        else if (transactionData.TransactionTypeCode == 'C' && transactionData.TransactionPlanCode == 'SWP') {
            var firstHolder = transactionData.ClientAccount.AccountHolders.find(x => x.SerialNumber == 1);

            var timeStamp = new Date();
            var link = process.env.WEB_APP_LINK + '/confirm-order/' + transactionData.ClientAccount.ClientId + '/' + firstHolder.ClientKycProfileId + '/' + ClientTransactionId + '/' + cryptoEngine.ParamEncrypt(transactionData.TransactionTypeCode, true) + '/' + cryptoEngine.ParamEncrypt('externalverify', true) + '/' + cryptoEngine.ParamEncrypt(timeStamp.toISOString(), true) + '/' + cryptoEngine.ParamEncrypt('new', true);
            console.log(link);
            var subject = 'Kinntegra | New MF Cancel SWP Order';
            emailEngine.SendClientOrderConfirmationLink(firstHolder.ProfileDetails.Email, firstHolder.ProfileDetails.Name, transactionData.ClientAccount.AssociateName, transactionData.ClientAccountList, link, subject);
        }
        else if (transactionData.TransactionTypeCode == 'SW' && transactionData.TransactionPlanCode == 'STP') {
            var clientAccounts = transactionData.ClientAccounts;

            var systemClientAccounts = clientAccounts.filter(item => item.UCC != '');

            if (systemClientAccounts.length > 0) {
                var firstHolder = transactionData.ClientAccount.AccountHolders.find(x => x.SerialNumber == 1);

                var timeStamp = new Date();
                var link = process.env.WEB_APP_LINK + '/confirm-order/' + transactionData.ClientAccount.ClientId + '/' + firstHolder.ClientKycProfileId + '/' + ClientTransactionId + '/' + cryptoEngine.ParamEncrypt(transactionData.TransactionTypeCode, true) + '/' + cryptoEngine.ParamEncrypt('externalverify', true) + '/' + cryptoEngine.ParamEncrypt(timeStamp.toISOString(), true) + '/' + cryptoEngine.ParamEncrypt('new', true);
                console.log(link);
                var subject = 'Kinntegra | New MF STP Switch Order';
                emailEngine.SendClientOrderConfirmationLink(firstHolder.ProfileDetails.Email, firstHolder.ProfileDetails.Name, transactionData.ClientAccount.AssociateName, transactionData.ClientAccountList, link, subject);
            }
        }
        else if (transactionData.TransactionTypeCode == 'SW' && transactionData.TransactionPlanCode == 'IS') {
            var clientAccounts = transactionData.ClientAccounts;

            var systemClientAccounts = clientAccounts.filter(item => item.UCC != '');

            if (systemClientAccounts.length > 0) {
                var firstHolder = transactionData.ClientAccount.AccountHolders.find(x => x.SerialNumber == 1);

                var timeStamp = new Date();
                var link = process.env.WEB_APP_LINK + '/confirm-order/' + transactionData.ClientAccount.ClientId + '/' + firstHolder.ClientKycProfileId + '/' + ClientTransactionId + '/' + cryptoEngine.ParamEncrypt(transactionData.TransactionTypeCode, true) + '/' + cryptoEngine.ParamEncrypt('externalverify', true) + '/' + cryptoEngine.ParamEncrypt(timeStamp.toISOString(), true) + '/' + cryptoEngine.ParamEncrypt('new', true);
                console.log(link);
                var subject = 'Kinntegra | New MF Intra Switch Order';
                emailEngine.SendClientOrderConfirmationLink(firstHolder.ProfileDetails.Email, firstHolder.ProfileDetails.Name, transactionData.ClientAccount.AssociateName, transactionData.ClientAccountList, link, subject);
            }
        }

        res.status(200).send({ Status: true, Message: "Payment details saved successfully...", Data: { ClientTransactionId: ClientTransactionId } });
    }
    catch (err) {
        console.log(err);
        res.status(500).send(errorMessage);
    }
};

