    try {
        var data;
        var currentDate = luxon.DateTime.now().setZone('Asia/Kolkata');

        const readRequest = req.app.locals.db.request();
        readRequest.input("Id", cryptoEngine.ParamDecrypt(AllocationId, true))
            .input("ClientTransactionId", cryptoEngine.ParamDecrypt(ClientTransactionId, true))
            .input("TradeDate", currentDate.toFormat('yyyy-MM-dd'));
        const readResult = await readRequest.execute("GetClientTransactionSTPSwitchAllocationFeedById");
        if (readResult.recordset.length > 0) {
            data = readResult.recordset[0];

            data.Id = cryptoEngine.ParamEncrypt(data.Id, true);
            data.ClientTransactionId = cryptoEngine.ParamEncrypt(data.ClientTransactionId, true);
            data.Schemes = [];
            data.IsDisableAllocationType = false;
            data.IsDisableSchemeTo = false;
            data.IsDisableUnits = false;
            data.IsDisableAmount = false;
        }

        if (data != null) {
            const readRecommendedRequest = req.app.locals.db.request();
            readRecommendedRequest.input("AMCCode", data.AMCCode)
                .input("ProductCode", data.ProductCodeSwitchFrom);
            const readRecommendedResult = await readRecommendedRequest.execute("GetSTPSwitchToRecommendedSchemes");
            if (readRecommendedResult.recordset.length > 0) {
                var recommendedSchemes = readRecommendedResult.recordset;
                for (let j = 0; j < recommendedSchemes.length; j++) {
                    var existingItem = data.Schemes.find(x => x.ProductCode == recommendedSchemes[j].ChannelPartnerCode);
                    if (existingItem == null) {
                        data.Schemes.push({ ProductCode: recommendedSchemes[j].ChannelPartnerCode, SchemeName: recommendedSchemes[j].SchemeName, ISIN: recommendedSchemes[j].ISIN, SchemeType: 'R' });
                    }
                }

                if (recommendedSchemes.length > 0) {
                    data.AllocationType = 'R';
                    data.ProductCodeSwitchTo = recommendedSchemes[0].ChannelPartnerCode;
                    data.IsDisableAllocationType = false;
                    data.IsDisableSchemeTo = true;
                }
            }
            else {
                data.AllocationType = 'C';
                data.IsDisableAllocationType = true;
                data.IsDisableSchemeTo = false;
            }

            const readNonRecommendedRequest = req.app.locals.db.request();
            readNonRecommendedRequest.input("AMCCode", data.AMCCode)
                .input("ProductCode", data.ProductCodeSwitchFrom);
            const readNonRecommendedResult = await readNonRecommendedRequest.execute("GetSTPSwitchToNonRecommendedSchemes");
            if (readNonRecommendedResult.recordset.length > 0) {
                var nonRecommendedSchemes = readNonRecommendedResult.recordset;
                for (let j = 0; j < nonRecommendedSchemes.length; j++) {
                    var existingItem = data.Schemes.find(x => x.ProductCode == nonRecommendedSchemes[j].ChannelPartnerCode);
                    if (existingItem == null) {
                        data.Schemes.push({ ProductCode: nonRecommendedSchemes[j].ChannelPartnerCode, SchemeName: nonRecommendedSchemes[j].SchemeName, ISIN: nonRecommendedSchemes[j].ISIN, SchemeType: 'N' });
                    }
                }
            }
        }

        res.status(200).send({ Status: true, Message: "", Data: data });
    }
    catch (err) {
        console.log(err);
        res.status(500).send(errorMessage);
    }
};

