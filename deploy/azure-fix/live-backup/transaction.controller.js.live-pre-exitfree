async function getSellTaxFeeData(req, res, ClientTransactionId) {
    var finYearStartDate;
    var finYearEndDate;
    var finYearProfit = 125000;
    var profitConsumed = 0;
    var profitAvailable = 0;
    var feedData = [];

    var currentDate = luxon.DateTime.now().setZone('Asia/Kolkata');

    var currentMonth = currentDate.month;
    var currentYear = currentDate.year;

    if (currentMonth >= 4 && currentMonth <= 12) {
        finYearStartDate = luxon.DateTime.fromObject({ year: currentYear, month: 4, day: 1 });
        finYearEndDate = luxon.DateTime.fromObject({ year: currentYear + 1, month: 3, day: 31 });
    }
    else {
        finYearStartDate = luxon.DateTime.fromObject({ year: currentYear - 1, month: 4, day: 1 });
        finYearEndDate = luxon.DateTime.fromObject({ year: currentYear, month: 3, day: 31 });
    }

    const readRequest = req.app.locals.db.request();
    readRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(ClientTransactionId, true))
        .input("FinYearStartDate", finYearStartDate.toFormat('yyyy-MM-dd'))
        .input("FinYearEndDate", finYearEndDate.toFormat('yyyy-MM-dd'));
    const readResult = await readRequest.execute("GetFeedTransactionFinYearProfitConsumed");
    if (readResult.recordset.length > 0) {
        profitConsumed = readResult.recordset[0].Profit;
    }

    // console.log(profitConsumed);

    profitAvailable = Math.round(finYearProfit - profitConsumed);

    // console.log(profitAvailable);

    const readFeedRequest = req.app.locals.db.request();
    readFeedRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(ClientTransactionId, true));
    const readFeedResult = await readFeedRequest.execute("GetClientTransactionSellTaxFreeAllocation");
    if (readFeedResult.recordset.length > 0) {
        var dataList = readFeedResult.recordset;

        feedData = dataList.map(item => {
            const Id = cryptoEngine.ParamEncrypt(item.Id, true);

            return { ...item, Id };
        });
    }

    if (profitAvailable > 0) {
        feedData.forEach(async item => {
            // console.log(profitAvailable);
            if (item.ProfitLoss <= profitAvailable) {
                item.TaxFreeAmount = Math.round(item.CurrentAmount);
                item.TaxFreeUnits = item.BalanceUnits;

                profitAvailable = profitAvailable - Math.round(item.ProfitLoss);
            }
            else {
                if (profitAvailable > 0) {
                    item.TaxFreeAmount = Math.round(item.CurrentAmount * profitAvailable / item.ProfitLoss);
                    item.TaxFreeUnits = (item.TaxFreeAmount * item.BalanceUnits) / item.CurrentAmount;
                }

                profitAvailable = 0;
            }

            await updateSellTaxFreeData(req, item.Id, item.TaxFreeAmount, item.TaxFreeUnits);
            // console.log('item.TaxFreeAmount: ' + item.TaxFreeAmount);
        });
    }

    return feedData;
};

