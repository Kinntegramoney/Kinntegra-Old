                var firstHolder = accountItem.AccountHolders.find(x => x.SerialNumber == 1);
                var secondHolder = accountItem.AccountHolders.find(x => x.SerialNumber == 2);
                var thirdHolder = accountItem.AccountHolders.find(x => x.SerialNumber == 3);
