exports.GetClientTransactionAllocationSell = async (req, res) => {
    const ClientTransactionId = req.params.ClientTransactionId;

    var errorMessage = "Error while fetching sell allocation...";

    try {
        var data = [];

        var clientTransactionData = await getClientTransactionInfo(req, res, ClientTransactionId);

        var currentDate = luxon.DateTime.now().setZone('Asia/Kolkata');

        var sellDataAll = [];

        if (clientTransactionData.TransactionPlanCode == 'ASWP') {
            const readRequest = req.app.locals.db.request();
            readRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(ClientTransactionId, true));
            const readResult = await readRequest.execute("GetClientTransactionAllocationSellASWP");
            if (readResult.recordset.length > 0) {
                // let dataList = readResult.recordset.filter(item => item.SellPriority > 0);
                let dataList = readResult.recordset;

                sellDataAll = dataList.map(item => {
                    const ClientTransactionPortfolioId = cryptoEngine.ParamEncrypt(item.ClientTransactionPortfolioId, true);
                    const BSESchemeId = cryptoEngine.ParamEncrypt(item.BSESchemeId, true);

                    return { ...item, ClientTransactionPortfolioId, BSESchemeId };
                });
            }
        }
        else {
            const readRequest = req.app.locals.db.request();
            readRequest.input("ClientTransactionId", cryptoEngine.ParamDecrypt(ClientTransactionId, true));
            const readResult = await readRequest.execute("GetClientTransactionAllocationSell");
            if (readResult.recordset.length > 0) {
                // let dataList = readResult.recordset.filter(item => item.SellPriority > 0);
                let dataList = readResult.recordset;

                sellDataAll = dataList.map(item => {
                    const ClientTransactionPortfolioId = cryptoEngine.ParamEncrypt(item.ClientTransactionPortfolioId, true);
                    const BSESchemeId = cryptoEngine.ParamEncrypt(item.BSESchemeId, true);

                    return { ...item, ClientTransactionPortfolioId, BSESchemeId };
                });
            }
        }

        var allocationAll = [];
        for (let s = 0; s < sellDataAll.length; s++) {
            var sellDataItem = sellDataAll[s];

            var schemeDetails = await getBseSchemeByIsin(sellDataItem.ISIN);
            allocationAll.push({
                ClientTransactionPortfolioId: sellDataItem.ClientTransactionPortfolioId,
                BSESchemeId: schemeDetails.Id,
                ISIN: sellDataItem.ISIN,
                SchemeName: sellDataItem.SchemeName,
                FolioNumber: sellDataItem.FolioNumber,
                ProductCode: sellDataItem.ProductCode,
                UCC: sellDataItem.UCC,
                FirstHolderPan: sellDataItem.FirstHolderPan,
                SecondHolderPan: sellDataItem.SecondHolderPan,
                ThirdHolderPan: sellDataItem.ThirdHolderPan,
                GuardianPan: sellDataItem.GuardianPan,
                FirstHolderName: sellDataItem.FirstHolderName,
                SecondHolderName: sellDataItem.SecondHolderName,
                ThirdHolderName: sellDataItem.ThirdHolderName,
                GuardianName: sellDataItem.GuardianName,
                FirstNomineeName: sellDataItem.Nominee1Name,
