                        var portfolioDataItem = allocationPortfolioData[i];

                        var ClientTransactionAllocationData = portfolioDataItem.Allocations.filter(x => x.FundAmount > 0);
                        for (let a = 0; a < ClientTransactionAllocationData.length; a++) {
                            var item = ClientTransactionAllocationData[a];
                            schemes.push(item.FundOtherDetails.SchemeName);
                        }
                    }

                    var schemeNames = schemes.join(', ');

                    var fileName = await prepareBuyLogicExcel(req, res, clientTransactionId);

                    var emailData = {
                        ClientName: firstHolder.ProfileDetails.Name,
                        Email: firstHolder.ProfileDetails.Email,
